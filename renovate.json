{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>berquerant/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^scripts/install_deps\\.sh$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n(?:[A-Z_]+_VERSION)=\"(?<currentValue>.*?)\""
      ]
    }
  ],
  "platformAutomerge": true
}
